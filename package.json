{
  "name": "creative-os-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/release-metadata.mjs && npm run catalog:build && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run catalog:build && tsc --noEmit",
    "test:studio": "node --import tsx --test tests/studio-core.test.ts tests/studio-bridge.test.mjs",
    "test:studio:browser": "node tests/studio-browser.mjs",
    "test:studio:harness": "node --import tsx tests/studio-harness.ts",
    "tokens:build": "node scripts/brand-tokens.mjs",
    "test:studio:brand": "node tests/studio-brand-browser.mjs",
    "test:studio:fonts": "node tests/studio-font-browser.mjs",
    "test:studio:open-fonts": "node tests/studio-open-font-browser.mjs",
    "fonts:vendor": "node scripts/vendor-open-fonts.mjs",
    "test:site:browser": "node tests/site-flow-browser.mjs",
    "test:site:examples": "node tests/site-examples-export-browser.mjs",
    "catalog:build": "node scripts/build-cult-catalog.mjs",
    "catalog:sync": "node scripts/sync-cult-registry.mjs",
    "predev": "npm run catalog:build",
    "test:components:browser": "node tests/component-library-browser.mjs",
    "test:components": "npm run catalog:build && node --test tests/component-catalog.test.mjs",
    "verify:alpha": "node scripts/verify-alpha-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-use-controllable-state": "1.3.0",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "culori": "^4.0.2",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "postcss": "^8.5.28",
    "radix-ui": "1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-use-measure": "2.1.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "undici": "8.12.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-compiler": "npm:typescript@5.9.3",
    "vite": "8.3.5"
  },
  "workspaces": [
    "apps/studio",
    "packages/contracts",
    "packages/ui",
    "packages/theme-core"
  ],
  "overrides": {
    "postcss-selector-parser": "7.1.7"
  }
}
