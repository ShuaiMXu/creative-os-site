{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "brand",
    "tokens",
    "components",
    "patterns"
  ],
  "properties": {
    "status": {
      "enum": [
        "not-started",
        "observed",
        "approved"
      ]
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principles",
        "voice",
        "assets"
      ],
      "properties": {
        "principles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "voice": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assets": {
          "$ref": "#/$defs/artifacts"
        },
        "voiceEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample",
              "source"
            ],
            "properties": {
              "sample": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "name",
          "value",
          "source",
          "status"
        ],
        "properties": {
          "category": {
            "enum": [
              "color",
              "type",
              "space",
              "radius",
              "shadow",
              "motion",
              "other"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/foundationStatus"
          },
          "variants": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "themes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "usage": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "variants",
          "states",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "variants": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "states": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "$ref": "#/$defs/foundationStatus"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "patterns": {
      "$ref": "#/$defs/artifacts"
    },
    "guidelines": {
      "$ref": "#/$defs/artifacts"
    }
  },
  "$defs": {
    "foundationStatus": {
      "enum": [
        "observed",
        "approved",
        "deprecated"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "source",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/foundationStatus"
          },
          "role": {
            "enum": [
              "logo",
              "mark",
              "favicon",
              "icon",
              "og-image",
              "font",
              "other"
            ]
          },
          "format": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
