{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/apps/web/",
      "destination": "/apps/portal/",
      "permanent": true
    },
    {
      "source": "/apps/web",
      "destination": "/apps/portal/",
      "permanent": true
    },
    {
      "source": "/apps/web/:path*",
      "destination": "/apps/portal/",
      "permanent": true
    }
  ]
}
