{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HappyHands external component catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "revision",
    "count",
    "previewCount",
    "previewEnvironment",
    "items"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "const": "Cult UI" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "count": { "type": "integer", "minimum": 1 },
    "previewCount": { "type": "integer", "minimum": 0 },
    "previewEnvironment": {
      "type": "object",
      "required": ["approvedForTargetProject"],
      "properties": { "approvedForTargetProject": { "const": false } }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "preview",
          "aliasOf",
          "limitations",
          "dependencies",
          "registryDependencies",
          "source",
          "sourceSha256",
          "license",
          "revision",
          "integration"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "buttons",
              "inputs",
              "cards",
              "navigation",
              "overlays",
              "type",
              "illustrations",
              "sections",
              "effects"
            ]
          },
          "preview": { "type": "boolean" },
          "aliasOf": { "type": ["string", "null"] },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "registryDependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source": {
            "type": "string",
            "pattern": "^/components/cult-ui/[a-z0-9-]+\\.json$"
          },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "license": { "const": "MIT" },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "integration": {
            "type": "object",
            "required": ["status", "approval", "automaticUse", "checks"],
            "properties": {
              "status": { "const": "candidate" },
              "approval": { "const": "required" },
              "automaticUse": { "const": false },
              "checks": {
                "type": "array",
                "minItems": 6,
                "uniqueItems": true,
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
